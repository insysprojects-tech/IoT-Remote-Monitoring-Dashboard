# ====================================
# IoT Remote Monitoring Dashboard — Production Environment Variables
# (Koyeb Backend + Supabase Database + Cloudflare Pages Frontend)
# ====================================

# --- App ---
APP_NAME=IoT Remote Monitoring Dashboard
APP_VERSION=1.0.0
DEBUG=false

# --- Database (Supabase Vanilla PostgreSQL) ---
# Tip: Use the Supabase Session Pooler URL (port 5432 or 6543)
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Data Retention (Protects Supabase 500 MB Free Tier) ---
TELEMETRY_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
ENABLE_APP_RETENTION_CLEANUP=true

# --- MQTT (EMQX Cloud Serverless) ---
MQTT_BROKER_HOST=j18eff7a.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_PATTERN=test/devices/+/power
MQTT_USE_TLS=true

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (Your Cloudflare Pages domain and custom domains) ---
# Can be a JSON array or comma-separated list
CORS_ORIGINS=["https://your-dashboard.pages.dev", "http://localhost:3000"]

